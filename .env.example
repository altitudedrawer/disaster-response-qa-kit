# Copy to .env and fill in locally. NEVER commit .env (it is in .gitignore).
# Load into your shell with:   set -a; source .env; set +a

# --- used by: python -m pipeline.publish (real publish only) ---
ARCGIS_URL=https://www.arcgis.com
ARCGIS_USERNAME=your-username-here
ARCGIS_PASSWORD=your-password-here

# --- used by: pytest tests/contract (auto-skipped while FEATURE_SERVICE_URL is empty) ---
FEATURE_SERVICE_URL=
# Only needed if the layer is NOT shared publicly:
ARCGIS_TOKEN=
CONTRACT_LOCAL_GEOJSON=output/m5_1yr.geojson
CONTRACT_MAX_SECONDS=5
